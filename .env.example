# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string. Local example:
#   postgresql://postgres:postgres@localhost:5432/stained_glass
# Supabase/Railway will give you one to paste in.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stained_glass

# From https://console.anthropic.com — only needed once the estimate
# endpoint is implemented, but config.py requires it to be set.
ANTHROPIC_API_KEY=sk-ant-...

# Single admin login. Generate the hash once with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$...

# Signs the session cookie. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this value instantly invalidates all existing sessions.
SESSION_SECRET_KEY=change-me

# Comma-separated list of frontend origins allowed to send credentialed
# requests. Local dev example if serving frontend/ via a static server:
CORS_ORIGINS=http://127.0.0.1:5500
# In production (Railway): CORS_ORIGINS=https://elsje.codes

# Set to true once the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# In production (Railway): SESSION_COOKIE_SECURE=true
